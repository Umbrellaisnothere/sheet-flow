# Server-only. Never prefix these with NEXT_PUBLIC_.
# Copy to .env.local for development. Do not commit real values.

# Google Cloud OAuth Web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:43173/api/auth/google/callback

# Encrypted session cookie (>=32 random characters)
SESSION_SECRET=

# Canonical site origin (no path, query, fragment, or credentials).
# Local development: http://127.0.0.1:43173
# Production: required, HTTPS only. Do not leave this unset in production —
# the app will not default to localhost. Example: https://your-confirmed-host
APP_ORIGIN=http://127.0.0.1:43173

# Postgres (Neon, Vercel Postgres, or local)
DATABASE_URL=
